nul
logs/**
*.vsix
qwen_promt_reslut.md
node_modules/@anthropic-ai/claude-agent-sdk/browser-sdk.*
node_modules/@anthropic-ai/claude-agent-sdk/bridge.*
node_modules/@anthropic-ai/claude-agent-sdk/*.d.ts
node_modules/@anthropic-ai/claude-agent-sdk/manifest*
# The Claude runtime (claude.exe, ~100 MB packed) is downloaded on first use (src/claude/runtime-installer.ts).
node_modules/@anthropic-ai/claude-agent-sdk-*/**
# Only the ESM build of the Cursor SDK is loaded (the extension keeps a native import()).
node_modules/@cursor/sdk/dist/cjs/**
node_modules/@cursor/sdk/dist/bundled/**
# The Cortex SDK is loaded through its ESM entry (@snowflake/cortex-agent-sdk/code).
node_modules/@snowflake/cortex-agent-sdk/dist-cjs/**
# Node loads the Statsig client from src/index.js; build/*.min.js are jsdelivr bundles.
node_modules/@statsig/js-client/build/**
# TypeScript declarations are compile-time only; **/*.ts does not match .d.cts.
node_modules/**/*.d.cts
node_modules/**/*.d.mts
node_modules/**/*.md
node_modules/**/README*
node_modules/**/CHANGELOG*
node_modules/**/SECURITY*
node_modules/**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/benchmark/**
node_modules/**/benchmarks/**
node_modules/**/examples/**
node_modules/**/docs/**
node_modules/**/*.cjs.map
node_modules/**/*.mjs.map
