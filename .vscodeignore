# tsc output is inlined in the bundle.
out/**
!out/extension.js
!out/webview/**
docs/**
subprojects/**
scripts/**
.gitignore
.yarnrc
webpack.config.js
vsc-extension-quickstart.md
.prettierignore
.prettierrc
eslint.config.mjs
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
*.log
